<?xml version="1.0" encoding="utf-8"?>
<!-- Place ONLY this file in the IIS proxy site's physical directory.
     Requires IIS URL Rewrite + ARR; enable proxy and preserveHostHeader at server level.
     Bind this site to HTTPS using the host in PUBLIC_ORIGIN. -->
<configuration><system.webServer>
  <security><requestFiltering><requestLimits maxAllowedContentLength="67108864" /></requestFiltering></security>
  <rewrite><rules><rule name="ChecklistNode" stopProcessing="true"><match url="(.*)" /><action type="Rewrite" url="http://127.0.0.1:3080/{R:1}" appendQueryString="true" /></rule></rules></rewrite>
</system.webServer></configuration>

# Node listens ONLY on loopback. IIS must expose HTTPS at this origin.
PUBLIC_ORIGIN=https://checklist.empresa.local
PORT=3080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=koide_checklist
MYSQL_USER=checklist_app
MYSQL_PASSWORD=CAMBIAR
# Required CA file if MySQL is on a different machine. No insecure TLS bypass.
MYSQL_SSL_CA=
BODY_LIMIT_MB=64
